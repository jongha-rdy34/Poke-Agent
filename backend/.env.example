# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올리지 않는다.

# --- LLM (2일차부터 사용) ---
GMS_API_KEY=
# 과정에서 안내한 GMS 접속 주소 (OpenAI 호환)
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# --- 메타 통계 기본값 ---
DEFAULT_FORMAT=gen9championsbssregmc
DEFAULT_RATING=1500

# --- 외부 데이터 (키 불필요, 보통 바꿀 일 없음) ---
# POKEAPI_BASE=https://pokeapi.co/api/v2
# SMOGON_STATS_BASE=https://www.smogon.com/stats
# SHOWDOWN_DATA_BASE=https://play.pokemonshowdown.com/data
HTTP_TIMEOUT=20
