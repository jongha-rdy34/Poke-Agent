[
  {
    "case": "등록된 Tool 명세",
    "specs": [
      {
        "name": "get_meta_usage",
        "description": "상대 포켓몬이 실전에서 주로 쓰는 기술·도구·특성·능력치 배분과 그 비율이 필요할 때 사용한다. 상대 6마리의 예상 세트를 볼 때, 또는 pokemon을 비워 현재 메타의 사용률 상위 후보 목록이 필요할 때 쓴다. 포맷·집계월·레이팅을 지정하지 않으면 기본값으로 조회하고 notes에 밝힌다.",
        "input_schema": {
          "properties": {
            "pokemon": {
              "description": "예상 세트를 볼 포켓몬 이름(영문/한국어). 비우면 사용률 상위 후보 목록을 돌려준다.",
              "items": {
                "type": "string"
              },
              "maxItems": 12,
              "title": "Pokemon",
              "type": "array"
            },
            "format": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Smogon 포맷 ID. 예: gen9championsbssregmc(싱글 6→3), gen9ou. 생략 시 기본 포맷.",
              "title": "Format"
            },
            "month": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "집계월 YYYY-MM. 생략 시 가장 최근 집계월.",
              "title": "Month"
            },
            "rating": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "레이팅 컷. 생략 시 1500.",
              "title": "Rating"
            },
            "top_n": {
              "default": 6,
              "description": "기술/도구 등을 상위 몇 개까지 돌려줄지",
              "maximum": 30,
              "minimum": 1,
              "title": "Top N",
              "type": "integer"
            }
          },
          "title": "MetaUsageInput",
          "type": "object"
        },
        "kind": "external",
        "source": "Smogon usage stats",
        "requirement": "F3002"
      },
      {
        "name": "get_pokemon_detail",
        "description": "포켓몬 한 마리의 타입·종족값(특히 스피드)·특성이 필요할 때 사용한다. 선공 여부나 타입 상성을 판단하기 전에 내 포켓몬과 상대 포켓몬 각각에 대해 호출한다. judgeable=false면 그 포켓몬은 판단하지 말고 제외 사유를 밝힌다.",
        "input_schema": {
          "properties": {
            "name": {
              "description": "포켓몬 이름. 영문(Garchomp-Mega-Z), PokeAPI 이름, 한국어(한카리아스) 모두 가능",
              "minLength": 1,
              "title": "Name",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "title": "PokemonDetailInput",
          "type": "object"
        },
        "kind": "external",
        "source": "PokeAPI",
        "requirement": "F3003"
      },
      {
        "name": "get_move_info",
        "description": "기술의 타입·물리/특수 분류·위력·명중률·우선도가 필요할 때 사용한다. 어떤 기술을 쓸지 비교하거나, 상대의 선공기(우선도>0)를 확인할 때 쓴다.",
        "input_schema": {
          "properties": {
            "moves": {
              "description": "기술 이름 목록. Smogon 기술 ID(earthquake), 영문, 한국어(지진) 모두 가능",
              "items": {
                "type": "string"
              },
              "maxItems": 24,
              "minItems": 1,
              "title": "Moves",
              "type": "array"
            }
          },
          "required": [
            "moves"
          ],
          "title": "MoveInfoInput",
          "type": "object"
        },
        "kind": "external",
        "source": "Pokémon Showdown data",
        "requirement": "F3004"
      },
      {
        "name": "get_type_matchup",
        "description": "공격 타입이 방어 포켓몬에게 몇 배로 들어가는지(0/0.25/0.5/1/2/4배) 계산이 필요할 때 사용한다. attack_types를 비우면 방어 측의 전체 약점·내성표를 돌려준다. 부유 같은 면역 특성은 defender_ability로 넘긴다.",
        "input_schema": {
          "properties": {
            "defend_types": {
              "description": "방어 측 타입 1~2개 (영문/한국어)",
              "items": {
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 1,
              "title": "Defend Types",
              "type": "array"
            },
            "attack_types": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "공격 기술 타입 목록. 생략 시 18타입 전체 약점표",
              "title": "Attack Types"
            },
            "defender_ability": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "방어 측 특성(부유, 저수 등 면역 특성 반영). 영문 이름",
              "title": "Defender Ability"
            }
          },
          "required": [
            "defend_types"
          ],
          "title": "TypeMatchupInput",
          "type": "object"
        },
        "kind": "external",
        "source": "Pokémon Showdown data",
        "requirement": "F3004"
      },
      {
        "name": "resolve_names",
        "description": "사용자가 한국어(예: 한카리아스, 지진)나 애매한 이름으로 말했을 때, 다른 Tool에 넘길 영문 식별자로 바꿀 때 사용한다. AMBIGUOUS가 나오면 Tool을 더 부르지 말고 사용자에게 정확한 이름을 되묻는다.",
        "input_schema": {
          "properties": {
            "names": {
              "description": "변환할 이름 목록",
              "items": {
                "type": "string"
              },
              "maxItems": 24,
              "minItems": 1,
              "title": "Names",
              "type": "array"
            },
            "kind": {
              "default": "pokemon",
              "description": "포켓몬 이름인지 기술 이름인지",
              "enum": [
                "pokemon",
                "move"
              ],
              "title": "Kind",
              "type": "string"
            }
          },
          "required": [
            "names"
          ],
          "title": "ResolveNamesInput",
          "type": "object"
        },
        "kind": "local",
        "source": "로컬 매핑 파일 (PokeAPI 수집본)",
        "requirement": "F3001"
      }
    ]
  },
